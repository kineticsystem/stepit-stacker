---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 26
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart TB
    subgraph Rig["THE RIG, STEPIT.LOCAL"]
        StackDone("<b>StackDone</b><br/>after the last shot<br/>of an angle")
        AllStacksDone("<b>AllStacksDone</b><br/>after the last angle")
        Rosbridge("<b>rosbridge</b><br/>port 9090")
        RigPictures[("<b>~/stepit-macro/pictures</b><br/>CR2 files, stack.json,<br/>all_stacks.json")]
        WebServer("<b>StepIt Camera's<br/>web server</b><br/>port 8090")
        StackDone -. "/focus_stack/<br/>stack_done" .-> Rosbridge
        AllStacksDone -. "/focus_stack/<br/>all_stacks_done" .-> Rosbridge
        StackDone -- "writes" --> RigPictures
        AllStacksDone -- "writes" --> RigPictures
    end
    Watcher{{"<b>Watcher</b><br/>pipeline/watch.py"}}
    subgraph PC["THE STEPS"]
        Develop("<b>1 · Develop</b><br/>raw-convert")
        Merge("<b>2 · Merge</b><br/>focus-merge")
        Grade("<b>3 · Grade</b><br/>stepit-grader-cli,<br/>grade.xmp")
        Quilt("<b>4 · Quilt</b>")
        Show("<b>5 · Show</b><br/>POST /quilt")
    end
    Watcher -- "each angle" --> Develop ==> Merge ==> Grade
    Watcher -- "each complete session" --> Quilt ==> Show
    Holo("<b>StepIt Holo's server</b><br/>holo.local, port 8095")
    Portrait(["<b>Looking Glass Portrait</b>"])
    Rosbridge -. "WebSocket, JSON" .-> Watcher
    RigPictures ==> WebServer
    WebServer == "HTTP: listings, files" ==> Watcher
    Show == "HTTP: the quilt" ==> Holo
    Holo == "HDMI" ==> Portrait

    classDef human fill:#ffe4e6,stroke:#e11d48,stroke-width:2px,color:#881337
    classDef voice fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef mind  fill:#ede9fe,stroke:#7c3aed,stroke-width:2px,color:#4c1d95
    classDef brain fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef robot fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#78350f
    classDef data  fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    classDef ext   fill:#f1f5f9,stroke:#64748b,stroke-width:2px,color:#0f172a

    class StackDone,AllStacksDone robot
    class Rosbridge,WebServer voice
    class RigPictures data
    class Watcher brain
    class Develop,Merge,Grade,Quilt,Show mind
    class Holo,Portrait ext

    style Rig fill:#f59e0b12,stroke:#f59e0b,stroke-width:1.5px,stroke-dasharray:6 5,color:#d97706
    style PC fill:#8b5cf612,stroke:#8b5cf6,stroke-width:1.5px,stroke-dasharray:6 5,color:#7c3aed

    linkStyle 0,1,9 stroke:#14b8a6,stroke-width:2px
    linkStyle 2,3 stroke:#3b82f6,stroke-width:2px
    linkStyle 4,7 stroke:#8b5cf6,stroke-width:2px
    linkStyle 5,6,8 stroke:#8b5cf6,stroke-width:3px
    linkStyle 10,11 stroke:#3b82f6,stroke-width:3px
    linkStyle 12,13 stroke:#64748b,stroke-width:3px

<?xml version="1.0" encoding="UTF-8"?>
<!--
  The grading of every merged image, applied by stepit-grader-cli: here, no
  edit, every value at its default. Replace this file with a sidecar saved by
  StepIt Grader for one merged image, see README.md.
-->
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="stepit-grader">
 <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <rdf:Description rdf:about="" xmlns:crs="http://ns.adobe.com/camera-raw-settings/1.0/"
    crs:ProcessVersion="11.0"
    crs:HasSettings="True"
    crs:IncrementalTemperature="0"
    crs:IncrementalTint="0"
    crs:DefringePurpleAmount="0"
    crs:DefringePurpleHueLo="30"
    crs:DefringePurpleHueHi="70"
    crs:Exposure2012="0.00"
    crs:Contrast2012="0"
    crs:Highlights2012="0"
    crs:Shadows2012="0"
    crs:Blacks2012="0"
    crs:Texture="0"
    crs:Clarity2012="0"
    crs:Vibrance="0"
    crs:Saturation="0"
    crs:HDRToneCompression="0"
    crs:HDRCompressionPoint="50"
    crs:HDRLocalContrast="50"
    crs:Sharpness="0" />
 </rdf:RDF>
</x:xmpmeta>
